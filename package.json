{
  "name": "fatorsimples",
  "productName": "FatorSimples",
  "version": "1.4.0",
  "description": "Calculadora desktop do Simples Nacional com Fator R: pró-labore ideal, DAS, INSS e IRRF com as tabelas de cada ano e comparativo Anexo III × V.",
  "author": "Leandro Tavares de Melo",
  "license": "MIT",
  "private": true,
  "main": "electron/main.cjs",
  "type": "module",
  "keywords": [
    "simples-nacional",
    "fator-r",
    "pgdas",
    "pro-labore",
    "impostos",
    "electron"
  ],
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "electron electron/main.cjs",
    "clean": "rm -rf dist release .electron-dist",
    "lint": "tsc --noEmit",
    "splash": "electron scripts/splash/render.cjs",
    "postinstall": "electron-builder install-app-deps",
    "dist:portable": "vite build && node scripts/prepare-electron-dist.mjs && electron-builder --win portable -c.electronDist=.electron-dist",
    "dist:win": "vite build && node scripts/prepare-electron-dist.mjs && electron-builder --win -c.electronDist=.electron-dist",
    "dist:mac": "vite build && electron-builder --mac",
    "dist:linux": "vite build && electron-builder --linux",
    "test": "vitest run"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "pdfjs-dist": "6.3.289"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "driver.js": "1.9.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.43.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^3.2.7"
  },
  "build": {
    "appId": "br.com.fatorsimples.app",
    "productName": "FatorSimples",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!electron/**/*.test.ts",
      "!node_modules/better-sqlite3/{src,deps,docs,benchmark}/**",
      "!node_modules/better-sqlite3/build/{Release/obj,Release/.deps,deps}/**",
      "!**/*.{md,map,ts,cc,h,gyp,gypi}"
    ],
    "electronLanguages": [
      "pt-BR",
      "en-US"
    ],
    "afterPack": "scripts/after-pack.cjs",
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "FatorSimples-${version}-portable.exe",
      "splashImage": "build/splash.bmp"
    },
    "nsis": {
      "artifactName": "FatorSimples-${version}-setup.exe",
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FatorSimples",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "uninstallDisplayName": "FatorSimples"
    },
    "mac": {
      "category": "public.app-category.finance",
      "icon": "build/icon.png",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "title": "${productName} ${version}"
    },
    "linux": {
      "category": "Office",
      "icon": "build/icon.png",
      "synopsis": "Simples Nacional e Fator R",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}"
    }
  }
}
